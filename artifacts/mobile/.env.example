# Local development settings for the app.
#   1. Copy this file to .env (same folder: artifacts/mobile/.env).
#   2. Fill in the two Supabase values from the Supabase dashboard for the
#      STAGING project: Project Settings → API (Project URL, publishable key).
#   3. From the repository root run:  pnpm mobile
#
# These values ship inside the app and are public by design.
# NEVER put the Supabase secret/service-role key, the database password,
# the DVLA key or any other server secret here — the app refuses to start
# with a secret key. .env and .env*.local are git-ignored.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The hosted staging API (reachable from a phone as well as the simulator).
EXPO_PUBLIC_API_URL=https://api-production-1dafc.up.railway.app
