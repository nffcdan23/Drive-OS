# Local development settings for the app. Copy to .env and fill in.
# These values ship inside the app and are public by design.
# NEVER put the Supabase secret/service-role key, the database password,
# the DVLA key or any other server secret here — the app refuses to start
# with a secret key.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_API_URL=https://<staging-api-host>
